# MongoDB Connection (use MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/pcos-care-connect?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=your-strong-secret-key-change-this
JWT_EXPIRE=7d

# Site Configuration
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Node Environment
NODE_ENV=production

# Gemini AI (get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
